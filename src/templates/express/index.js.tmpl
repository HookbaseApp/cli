// IMPORTANT: signature verification needs the *raw* body bytes, not a parsed
// object. express.raw gives us the buffer; we parse JSON ourselves after.
app.post('/webhook', express.raw({ type: '*/*' }), (req, res) => {
  const rawBody = req.body.toString('utf8');
  // The verifier reads whatever headers its provider signs — the signature, and for some
  // providers a timestamp or message id alongside it.
  const getHeader = (name) => String(req.headers[name.toLowerCase()] ?? '');
  const requestUrl = `${req.protocol}://${req.get('host')}${req.originalUrl}`;

  const ok = verifySignature(rawBody, SIGNING_SECRET, getHeader, requestUrl);
  if (!ok) {
    return res.status(401).json({ error: 'invalid signature' });
  }

  let payload;
  try { payload = JSON.parse(rawBody); } catch { payload = {}; }

  console.log('Received event:', payload.type || payload.event || 'unknown');
  res.status(200).json({ received: true });
});

app.listen(PORT, () => {
  console.log(`{{PROVIDER_LABEL}} webhook handler listening on http://localhost:${PORT}/webhook`);
});
